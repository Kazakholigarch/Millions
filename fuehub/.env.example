# Copy to .env and fill in for your environment. Nothing here is required to
# run the demo — every integration falls back to a safe local/simulated mode
# when its credentials are absent (see README "What's real vs. stubbed").

# Flask
FUEHUB_SECRET_KEY=change-me
FUEHUB_DATABASE_URI=sqlite:///instance/fuehub.db

# AI drafting/translation. Provider is "fake" (deterministic, offline,
# template-based) unless you set this to "anthropic" and supply a key.
FUEHUB_AI_PROVIDER=fake
ANTHROPIC_API_KEY=

# Channel sending. Each defaults to a "log" adapter that records what would
# have been sent without calling any external API. Set the matching
# credentials to switch a channel to its real adapter.

# WhatsApp Business (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Instagram DM (Meta Graph API)
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=fuehub-verify

# Outbound email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Inbound email webhook shared secret (e.g. Mailgun/SendGrid inbound parse)
EMAIL_WEBHOOK_SECRET=
